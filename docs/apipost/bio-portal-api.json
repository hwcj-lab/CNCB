          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('统一响应code为OK', () => pm.expect(body.code).to.eql('OK'));",
                  "pm.test('响应包含data和timestamp', () => { pm.expect(body).to.have.property('data'); pm.expect(body).to.have.property('timestamp'); });",
                  "pm.test('data为数组', () => pm.expect(pm.response.json().data).to.be.an('array'));",
                  "pm.test('每组均包含非空databases', () => pm.response.json().data.forEach(x => { pm.expect(x).to.have.property('dataType'); pm.expect(x.databases).to.be.an('array').and.not.empty; }));"
