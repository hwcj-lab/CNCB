                  "pm.test('data为数组', () => pm.expect(pm.response.json().data).to.be.an('array'));",
                  "pm.test('只返回DNA中的GenBase', () => { const data=pm.response.json().data; pm.expect(data).to.have.length(1); pm.expect(data[0].dataType.code).to.eql('DNA'); pm.expect(data[0].databases[0].name).to.eql('GenBase'); });"
